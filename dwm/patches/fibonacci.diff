diff --git a/fibonacci.c b/fibonacci.c
new file mode 100644
index 0000000..ca6c92c
--- /dev/null
+++ b/fibonacci.c
@@ -0,0 +1,110 @@
+/*
+ * fibonacci.c - spiral and dwindle layouts for dwm.
+ *
+ * Based on the fibonacci patch by Jeroen Schot / Niki Yoshiuchi
+ * (https://dwm.suckless.org/patches/fibonacci/), extended to honour the
+ * vanitygaps settings (gappoh, gappov, gappih, gappiv, smartgaps,
+ * enablegaps). Must be included from config.h after the gap variables
+ * have been declared, and requires the vanitygaps patch to be applied.
+ */
+
+static void
+fibonacci(Monitor *m, int s)
+{
+	unsigned int i, n;
+	int nx, ny, nw, nh;
+	int oh, ov, ih, iv;
+	int nv, hrest = 0, wrest = 0, r = 1;
+	Client *c;
+
+	for (n = 0, c = nexttiled(m->clients); c; c = nexttiled(c->next), n++);
+	if (n == 0)
+		return;
+
+	oh = m->gappoh * enablegaps;
+	ov = m->gappov * enablegaps;
+	ih = m->gappih * enablegaps;
+	iv = m->gappiv * enablegaps;
+	if (smartgaps == n)
+		oh = ov = 0; /* no outer gaps for a single window */
+
+	nx = m->wx + ov;
+	ny = m->wy + oh;
+	nw = m->ww - 2 * ov;
+	nh = m->wh - 2 * oh;
+
+	for (i = 0, c = nexttiled(m->clients); c; c = nexttiled(c->next)) {
+		if (r) {
+			if ((i % 2 && (nh - ih) / 2 <= (bh + 2 * c->bw))
+			|| (!(i % 2) && (nw - iv) / 2 <= (bh + 2 * c->bw)))
+				r = 0; /* too small to split further, stack the rest */
+			if (r && i < n - 1) {
+				if (i % 2) {
+					nv = (nh - ih) / 2;
+					hrest = nh - 2 * nv - ih;
+					nh = nv;
+				} else {
+					nv = (nw - iv) / 2;
+					wrest = nw - 2 * nv - iv;
+					nw = nv;
+				}
+
+				if ((i % 4) == 2 && !s)
+					nx += nw + iv;
+				else if ((i % 4) == 3 && !s)
+					ny += nh + ih;
+			}
+
+			if ((i % 4) == 0) {
+				if (s) {
+					ny += nh + ih;
+					nh += hrest;
+				} else {
+					nh -= hrest;
+					ny -= nh + ih;
+				}
+			} else if ((i % 4) == 1) {
+				nx += nw + iv;
+				nw += wrest;
+			} else if ((i % 4) == 2) {
+				ny += nh + ih;
+				nh += hrest;
+				if (i < n - 1)
+					nw += wrest;
+			} else if ((i % 4) == 3) {
+				if (s) {
+					nx += nw + iv;
+					nw -= wrest;
+				} else {
+					nw -= wrest;
+					nx -= nw + iv;
+					nh += hrest;
+				}
+			}
+
+			if (i == 0) {
+				if (n != 1) {
+					nw = (m->ww - iv - 2 * ov) * m->mfact;
+					wrest = 0;
+				}
+				ny = m->wy + oh;
+			} else if (i == 1)
+				nw = m->ww - nw - iv - 2 * ov;
+			i++;
+		}
+
+		resize(c, nx, ny, nw - (2 * c->bw), nh - (2 * c->bw), False);
+	}
+}
+
+static void
+dwindle(Monitor *m)
+{
+	fibonacci(m, 1);
+}
+
+static void
+spiral(Monitor *m)
+{
+	fibonacci(m, 0);
+}
